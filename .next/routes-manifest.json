    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/company/crowdcount/",
      "statusCode": 308,
      "regex": "^(?!/_next)/linkedin(?:/)?$"
    },
    {
      "source": "/beta-app",
