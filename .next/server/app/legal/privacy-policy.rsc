9b:["$","li",null,{"children":"We collect the promotion content you provide including images, titles, descriptions, call-to-action text, and destination URLs."}]
9c:["$","li",null,{"children":"Images are processed (cropped, resized, and compressed) before being transmitted to our servers."}]
9d:["$","li",null,{"children":"Payment for promotions is processed through Stripe. See Stripe's Privacy Policy for details on payment data handling."}]
9e:["$","li",null,{"children":"Approved promotions are displayed to users of our app and website."}]
9f:["$","li",null,{"children":"We track promotion clicks in an anonymized manner to provide performance metrics. Individual user click data is not retained."}]
