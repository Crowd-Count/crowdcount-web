31:["$","li",null,{"children":"Process payments for our products."}]
32:["$","li",null,{"children":"Ship purchased products to your specified address."}]
33:["$","li",null,{"children":"Provide you with counting data and history taken from the Crowd Counter."}]
34:["$","li",null,{"children":"Show Crowd Counters on the map and center the map to your location."}]
35:["$","li",null,{"children":"Use general app usage data as aggregated analytical data on our end."}]
36:["$","li",null,{"children":"Test, validate, and improve our models and systems during pilot programs, as described in Section 14."}]
37:["$","li",null,{"children":"Send you push notifications about overcrowding alerts and important service updates if you have enabled notifications."}]
38:["$","li",null,{"children":"Process and display promotions you create through our app."}]
39:["$","li",null,{"children":"Investigate and respond to reports submitted through our website."}]
3a:["$","li",null,{"children":"Track promotion engagement (clicks) in an anonymized manner."}]
