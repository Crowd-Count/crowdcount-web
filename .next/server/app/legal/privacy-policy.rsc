19:["$","div",null,{"id":"primary","children":"3. How We Collect Data"}]
1a:["$","br",null,{}]
1b:["$","li",null,{"children":"We collect personal data when you purchase our product through a form on our website. The data collection is facilitated by Stripe, a third party payment processor."}]
1c:["$","li",null,{"children":"Data such as camera footage is also collected from the Crowd Counter and processed in real time by our servers to generate occupancy counts. In standard production deployments the footage is not stored or accessible for later viewing. During pilot programs, we may temporarily store and review limited portions of footage as described in Section 14."}]
1d:["$","li",null,{"children":"Population counting data is taken from the processed footage of the counter."}]
1e:["$","li",null,{"children":"User location for the map is collected by the browser."}]
1f:["$","li",null,{"children":"Counter location for the map is collected when the client sends us a message requesting to be added to the map."}]
20:["$","li",null,{"children":"General app usage data is collected by the app. Absolutely no data regarding the app's specific user identity is collected."}]
21:["$","li",null,{"children":"Push notification tokens are collected when you grant notification permissions in our iOS app and register for overcrowding alerts."}]
22:["$","li",null,{"children":"Bluetooth communication occurs during device setup when your iOS device pairs with a Crowd Counter to transmit WiFi credentials."}]
23:["$","li",null,{"children":"QR code data is captured via your phone's camera during device provisioning to identify and authenticate your counter."}]
24:["$","li",null,{"children":"Photo data is collected when you select images from your photo library for promotion submissions."}]
25:["$","li",null,{"children":"Report data is collected when you voluntarily submit a report through our website's report form."}]
26:["$","br",null,{}]
27:["$","div",null,{"id":"primary","children":"4. Data Collection from Children"}]
28:["$","br",null,{}]
