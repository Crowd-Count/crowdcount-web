92:["$","li",null,{"children":"We may send service notifications about important updates, maintenance, or issues affecting your counter."}]
93:["$","li",null,{"children":"You can opt out of notifications at any time by disabling them in your device's Settings app or by unregistering from specific counter alerts within the CrowdCount app."}]
94:["$","li",null,{"children":"Your device token is stored on our servers only for the purpose of delivering notifications and is deleted when you unregister or uninstall the app."}]
