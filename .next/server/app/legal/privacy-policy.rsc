a8:["$","li",null,{"children":[["$","b",null,{"children":"Device Settings:"}]," Your connected counter device IDs, custom device names, and preferences."]}]
a9:["$","li",null,{"children":[["$","b",null,{"children":"Device Credentials:"}]," Passwords for your counter devices are stored locally to authenticate API requests."]}]
aa:["$","li",null,{"children":[["$","b",null,{"children":"Theme Preferences:"}]," Your dark mode and display preferences."]}]
ab:["$","li",null,{"children":[["$","b",null,{"children":"Promotion Data:"}]," If you create promotions, the promotion content and images are stored locally."]}]
