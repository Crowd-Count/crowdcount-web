20:["$","li",null,{"children":[["$","b",null,{"children":"Prohibited Content:"}]," Promotions may not contain: illegal content, hate speech, sexually explicit material, violent content, malware or phishing links, misleading claims, or content that infringes on third-party intellectual property rights."]}]
21:["$","li",null,{"children":[["$","b",null,{"children":"Review Process:"}]," All promotions are subject to review and approval by CrowdCount. We reserve the right to reject or remove any promotion at our sole discretion without providing a reason."]}]
22:["$","li",null,{"children":[["$","b",null,{"children":"Refunds:"}]," If your promotion is rejected during our review process, you will receive a refund of the purchase amount minus payment processing fees (3% + $0.30). If a promotion is approved and begins running but is later removed due to a violation of these terms, no refund will be provided. Refunds are processed through your original payment method and may take 5-10 business days to appear."]}]
23:["$","li",null,{"children":[["$","b",null,{"children":"Pricing:"}]," Promotion pricing is as stated at the time of purchase. We reserve the right to change pricing for future promotions."]}]
